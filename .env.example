# Copie para .env e preencha. O .env nunca é versionado (veja .gitignore).
#
# Provedor de IA: "gemini" (padrão), "cloudflare" ou "nenhum".
# Com "nenhum" o boletim é gerado sem narrativa de IA — útil para testar o
# pipeline em rede que bloqueia domínios de IA.
PROVEDOR_IA=gemini

# --- Gemini (Google AI Studio) -------------------------------------------
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# --- Cloudflare Workers AI (alternativa) ----------------------------------
# Free tier: https://dash.cloudflare.com -> AI -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODELO=@cf/meta/llama-3.1-8b-instruct
